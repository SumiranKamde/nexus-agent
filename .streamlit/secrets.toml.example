# Streamlit Community Cloud — Secrets Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy the contents of this file into:
#   Streamlit Cloud → Your App → Settings → Secrets
#
# Replace all placeholder values with your real keys.
# ─────────────────────────────────────────────────────────────────────────────

GEMINI_API_KEY = "your-gemini-api-key-here"
GROQ_API_KEY = "your-groq-api-key-here"

# Twilio (optional — only needed for WhatsApp notifications)
TWILIO_ACCOUNT_SID = "your-twilio-account-sid"
TWILIO_AUTH_TOKEN = "your-twilio-auth-token"
TWILIO_WHATSAPP_FROM = "whatsapp:+14155238886"
TWILIO_WHATSAPP_TO = "whatsapp:+91XXXXXXXXXX"
